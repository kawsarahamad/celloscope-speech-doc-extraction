.git
.gitignore
.env
__pycache__
*.pyc
.pytest_cache
.venv
tests
# Exclude the bulky sample audio/images/PDF, but NOT testdata/fixtures/
# -- the mock adapters replay those JSON files from disk at runtime, so
# they must ship in the image. (.dockerignore can't reliably re-include
# a path via `!` once a parent dir is excluded, so these are listed
# explicitly instead of excluding all of testdata/.)
testdata/wavs
testdata/*.wav
testdata/*.png
testdata/*.pdf
README.md
DECISIONS.md