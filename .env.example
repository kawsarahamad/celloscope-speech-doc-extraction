# Copy this file to .env and fill in real values ONLY if you want to
# exercise the real adapters. The default (no .env at all, or this
# file copied unedited) runs entirely on mocks -- no credentials or
# model download required.

# --- Provider selection ---
# Options: mock | whisper | gemini
TRANSCRIPTION_PROVIDER=mock
# Options: mock | gemini
EXTRACTION_PROVIDER=mock

# --- Real transcription adapter option A: self-hosted Whisper ---
# Only read when TRANSCRIPTION_PROVIDER=whisper. No key needed -- model
# weights download on first use via the whisper/faster-whisper library.
WHISPER_MODEL_SIZE=small
# auto | cpu | cuda -- "auto" picks GPU if available, falls back to CPU.
WHISPER_DEVICE=auto

# --- Real transcription adapter option B, and real extraction adapter:
# Gemini API (free tier) ---
# Read when TRANSCRIPTION_PROVIDER=gemini and/or EXTRACTION_PROVIDER=gemini.
# Get a free-tier key at https://aistudio.google.com -- no credit card
# required.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash